---
import { education, skillGroups } from '../data/portfolio';
---

<section id="education" class="section">
  <div class="container">
    <div class="edu-skills-grid">
      <div>
        <div class="section-header">
          <div>
            <h2 class="section-title">Education</h2>
            <p class="section-subtitle">Academic Background</p>
          </div>
        </div>

        <div class="edu-list">
          {education.map((edu) => (
            <div class="card edu-card">
              <div class="edu-degree">{edu.degree} — {edu.field}</div>
              <div class="edu-inst">{edu.institution}</div>
              {edu.note && <div class="edu-note">{edu.note}</div>}
            </div>
          ))}
        </div>
      </div>

      <div>
        <div class="section-header">
          <div>
            <h2 class="section-title">Technical Skills</h2>
            <p class="section-subtitle">Core Stack &amp; Tooling</p>
          </div>
        </div>

        <div class="skills-list">
          {skillGroups.map((group) => (
            <div class="card skill-card">
              <h3 class="skill-category">{group.category}</h3>
              <div class="skill-tags">
                {group.items.map((item) => (
                  <span class="badge badge-neutral">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edu-skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .edu-list,
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .edu-card,
  .skill-card {
    padding: 1.15rem 1.35rem;
  }

  .edu-degree {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .edu-inst {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 500;
  }

  .edu-note {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .skill-category {
    margin: 0 0 0.75rem;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  @media (max-width: 820px) {
    .edu-skills-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
